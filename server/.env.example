PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campuskhoj
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Cloudinary — photo storage in production (free account at cloudinary.com).
# Without these, uploads fall back to the local server/uploads/ folder,
# whose contents are lost whenever an ephemeral host (e.g. Render) redeploys.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
